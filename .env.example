# ---------------------------------------------------------------------------
# Landmark Properties — System 1
# Copy to .env.local and fill in. .env.local is git-ignored; this file is not.
# ---------------------------------------------------------------------------

# Database (Supabase → Project Settings → Database → Connection string → URI)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — "gemini" while building, "claude" for the pilot
AI_PROVIDER=gemini
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
ANTHROPIC_MODEL=claude-sonnet-5
# Several keys = several free allowances. Comma-separated, no spaces.
# When set, this is used instead of GEMINI_API_KEY.
GEMINI_API_KEYS=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp (Phase 3 — leave blank until then)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Only for local testing against a fake Meta. Leave blank in production.
WHATSAPP_API_BASE=

# Security — generate each with:  openssl rand -base64 32
CRON_SECRET=
LEAD_WEBHOOK_SECRET=
AUTH_SECRET=

# Business config
OFFICE_OPEN=09:30
OFFICE_CLOSE=19:00
EVENING_CLOSE=21:00
TIMEZONE=Asia/Kolkata
